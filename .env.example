# 首次部署时请替换为至少 32 字节的随机值，部署后不要随意修改。
PLATFORM_CREDENTIALS_KEY=replace-with-a-long-random-secret

# 仅在启用飞书、钉钉或企业微信长连接网关时填写。
HAIXIN_ACCOUNTS_JSON=

# 应用默认模型（可在平台页面为每个用户和机器人单独配置）。
# MODEL_BASE_URL 为所有模型/图片接口的统一中转地址；若需要切换中转服务，修改此处即可，
# 不再需要改动代码或重置数据库中的 baseUrl 列。
MODEL_API_KEY=
MODEL_BASE_URL=https://claudecc.top
MODEL_NAME=gpt-5.5

# 通道网关管理密钥。
HAIXIN_GATEWAY_ADMIN_SECRET=replace-with-a-long-random-gateway-secret
